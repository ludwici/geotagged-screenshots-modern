{
  "schemaVersion": 1,
  "id": "geotagged_screenshots_modern",
  "version": "${version}",
  "name": "Geotagged Screenshots Modern",
  "description": "Creates screenshot waypoints and previews in Xaero's World Map",
  "authors": [
    "ludwici"
  ],
  "contact": {
    "sources": "https://github.com/ludwici/geotagged-screenshots-modern",
    "issues": "https://github.com/ludwici/geotagged-screenshots-modern/issues",
    "homepage": "https://github.com/ludwici/geotagged-screenshots-modern"
  },
  "license": "LGPL-3.0",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ccr4ft3r.geotaggedscreenshots.GeotaggedScreenshots"
    ]
  },
  "mixins": [
    "geotagged_screenshots_modern.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": "*",
    "xaeroworldmap": ">=1.47.2",
    "xaerominimap": ">=26.6.2"
  }
}
